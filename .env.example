# Copy this file to .env and fill in. Never commit .env.

# Which LLM backend to use: mock (no key, offline), none (no LLM, baseline), litellm (real model)
LLM_PROVIDER=mock

# Priority: Claude first, then Gemini fallbacks (in order)
LLM_MODEL=anthropic/claude-haiku-5-5
LLM_FALLBACKS=gemini/gemini-3.6-flash,gemini/gemini-3.5-flash-lite
# Free-tier layout (no paid credit; used for python -m benchmark.run --subset). Needs GEMINI_API_KEY and GROQ_API_KEY:
# LLM_MODEL=gemini/gemini-3.5-flash-lite
# LLM_FALLBACKS=groq/openai/gpt-oss-120b,groq/openai/gpt-oss-20b

# API keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional extra backups (add to LLM_FALLBACKS if used): groq/openai/gpt-oss-120b, ollama/gpt-oss:20b
GROQ_API_KEY=

# Hardware (only for --hardware). Real board: COM3 or /dev/ttyUSB0. Wokwi: rfc2217://localhost:4000
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# Dashboard password for live LLM runs on the hosted app
APP_PASSWORD=
