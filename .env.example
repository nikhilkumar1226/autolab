# Copy this file to .env and fill in. Never commit .env.

# Which LLM backend to use: mock (no key, offline), none (no LLM, baseline), litellm (real model)
LLM_PROVIDER=mock

# Main model (free): Groq. Others: gemini/<model>, ollama/gpt-oss:20b
LLM_MODEL=groq/openai/gpt-oss-120b
# Comma-separated fallbacks used when the main model hits its free limit
LLM_FALLBACKS=gemini/gemini-3.5-flash-lite,ollama/gpt-oss:20b

# API keys (only the one for your chosen provider is needed)
GROQ_API_KEY=
GEMINI_API_KEY=
# Ollama needs no key; it must be running locally (ollama serve)
OLLAMA_API_BASE=http://localhost:11434

# Hardware (only for --hardware). Real board: COM3 or /dev/ttyUSB0. Wokwi: rfc2217://localhost:4000
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# Dashboard password for live LLM runs on the hosted app
APP_PASSWORD=
